{
  "admin": {
    "enabled": false,
    "host": "admin.msime.app",
    "token_env": "MSIME_ADMIN_TOKEN",
    "google": {
      "client_id": "",
      "secret_env": "MSIME_ADMIN_GOOGLE_SECRET",
      "redirect_uri": "https://admin.msime.app/api/auth/google/callback",
      "allowed_emails_env": "MSIME_ADMIN_GOOGLE_EMAILS"
    },
    "environment": "生产环境",
    "github": {
      "app_id": 0,
      "installation_id": 0,
      "private_key_env": "MSIME_ADMIN_GITHUB_APP_KEY",
      "dictionary_repo": "metasequoiaime/msime-dictionary",
      "issue_repos": ["metasequoiaime/msime", "metasequoiaime/msime-windows"],
      "platforms": [
        {
          "id": "windows",
          "name": "Windows",
          "repo": "metasequoiaime/msime-windows",
          "tag_prefix": "windows-v",
          "release_workflow": "release.yml",
          "assignee": "houko",
          "label": "windows"
        }
      ]
    },
    "services": [
      {
        "key": "translation",
        "name": "翻译",
        "provider": "DeepL",
        "quota": {"limit": 500000, "unit": "chars", "period": "month", "unit_price": 0},
        "slow_ms": 3000
      }
    ],
    "telegram": {
      "bot_token_env": "MSIME_ADMIN_TELEGRAM_TOKEN",
      "chat_id": ""
    },
    "logs": {
      "loki_url": "",
      "selector": "{namespace=\"app\",container=\"msime-backend\"}"
    }
  },
  "docs_enabled": false,
  "listen": "127.0.0.1:8080",
  "max_concurrent": 32,
  "replicas": 1,
  "request_log": true,
  "timeout_seconds": 30,
  "clients": [
    {
      "id": "personal-device",
      "token_env": "MSIME_CLIENT_TOKEN",
      "requests_per_minute": 120
    }
  ],
  "cloud": {
    "url": "https://inputtools.google.com/request"
  },
  "chat": {
    "url": "",
    "token_env": "MSIME_CHAT_TOKEN",
    "model": "",
    "fallback_model": ""
  },
  "translation": {
    "url": "",
    "token_env": "MSIME_TRANSLATION_TOKEN"
  },
  "niutrans": {
    "document": {
      "url": "https://api.niutrans.com/v2/doc/translate/upload",
      "app_id_env": "MSIME_NIUTRANS_DOC_APP_ID",
      "apikey_env": "MSIME_NIUTRANS_APIKEY"
    },
    "image": {
      "url": "https://api.niutrans.com/v2/image/translate/upload",
      "app_id_env": "MSIME_NIUTRANS_IMAGE_APP_ID",
      "apikey_env": "MSIME_NIUTRANS_APIKEY"
    },
    "voice": {
      "url": "https://api.niutrans.com/v2/voice/translate/upload",
      "app_id_env": "MSIME_NIUTRANS_VOICE_APP_ID",
      "apikey_env": "MSIME_NIUTRANS_APIKEY"
    },
    "resource": {
      "url": "https://api.niutrans.com/v2/resource",
      "app_id_env": "MSIME_NIUTRANS_RESOURCE_APP_ID",
      "apikey_env": "MSIME_NIUTRANS_APIKEY"
    }
  },
  "transcription": {
    "url": "",
    "token_env": "MSIME_TRANSCRIPTION_TOKEN",
    "model": ""
  },
  "streaming": {
    "url": "",
    "token_env": "MSIME_STREAMING_TOKEN",
    "app_key_env": "",
    "resource_id": "volc.seedasr.sauc.duration",
    "max_seconds": 120
  },
  "allowed_origins": [],
  "client_ip_header": "",
  "site_proxy_secret_env": "",
  "word_submissions": {
    "turnstile": {
      "site_key": "",
      "secret_env": "MSIME_TURNSTILE_SECRET"
    },
    "github": {
      "app_id": 0,
      "installation_id": 0,
      "private_key_env": "MSIME_WORDS_GITHUB_APP_KEY",
      "repository": "metasequoiaime/msime-dictionary",
      "branch": "main"
    }
  },
  "auth": {
    "enabled": false,
    "database_env": "MSIME_DATABASE_URL",
    "pepper_env": "MSIME_AUTH_PEPPER",
    "token_key_env": "MSIME_PROVIDER_TOKEN_KEY",
    "apple": {
      "client_ids": []
    },
    "anonymous": {
      "enabled": false,
      "daily_per_address": 5
    },
    "google": {
      "client_ids": [],
      "desktop": {
        "client_id": "",
        "secret_env": "MSIME_GOOGLE_DESKTOP_CLIENT_SECRET"
      }
    },
    "wechat": {
      "app_id": "",
      "secret_env": "MSIME_WECHAT_SECRET",
      "redirect_uri": ""
    },
    "sms": {
      "region": "cn-hangzhou",
      "access_key_id_env": "MSIME_ALIYUN_ACCESS_KEY_ID",
      "access_key_secret_env": "MSIME_ALIYUN_ACCESS_KEY_SECRET",
      "sign_name": "",
      "template_code": ""
    },
    "email": {
      "host": "smtp.larksuite.com",
      "port": 465,
      "username": "",
      "password_env": "MSIME_SMTP_PASSWORD",
      "from": ""
    },
    "avatars": {
      "bucket": "",
      "public_base_url": "https://media.msime.app",
      "account_id_env": "MSIME_R2_ACCOUNT_ID",
      "access_key_id_env": "MSIME_R2_ACCESS_KEY_ID",
      "secret_access_key_env": "MSIME_R2_SECRET_ACCESS_KEY"
    },
    "community": {
      "official_skin_publishers": [],
      "canvas_resources": false
    }
  }
}
