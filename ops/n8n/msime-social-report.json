              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({site_id: $('准备查询').first().json.site_id, date_range: [$('准备查询').first().json.period_start, $('准备查询').first().json.period_end], metrics: ['visitors', 'visits'], dimensions: ['visit:utm_source', 'visit:utm_medium', 'visit:utm_campaign'], filters: [['is', 'visit:utm_medium', ['social']]]}) }}",
        "options": {}
      },
