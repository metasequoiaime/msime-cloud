        "jsCode": "const end = new Date();\nconst start = new Date(end.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst repository = String($env.MSIME_GITHUB_REPOSITORY ?? '');\nif (!repository || !$env.MSIME_GITHUB_TOKEN) {\n  throw new Error('缺少周报所需的 GitHub 配置');\n}\nconst date = (value) => value.toISOString().slice(0, 10);\nreturn [{json: {\n  period_start: date(start),\n  period_end: date(end),\n  start_at: start.getTime(),\n  end_at: end.getTime(),\n  repository,\n  umami_base_url: String($env.MSIME_UMAMI_BASE_URL ?? '').replace(/\\/$/, ''),\n  website_id: String($env.MSIME_UMAMI_WEBSITE_ID ?? ''),\n  install_event: String($env.MSIME_UMAMI_INSTALL_EVENT ?? 'Install')\n}}];"
