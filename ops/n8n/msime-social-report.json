      "parameters": {
        "jsCode": "const queries = $('准备安装查询').all();\nconst data = $input.all().map((item, index) => {\n  const body = item.json.body ?? item.json;\n  return {utmSource: queries[index].json.source || 'unknown', events: Number(body.data?.events ?? 0), error: item.json.error};\n});\nconst error = data.find(row => row.error)?.error;\nreturn [{json: {installs: error ? {error} : data.filter(row => row.utmSource !== 'unknown' || row.events > 0), period: $('准备查询').first().json}}];"
      },
