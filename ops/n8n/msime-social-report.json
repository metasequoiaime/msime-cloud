      "parameters": {
        "jsCode": "const end = new Date();\nconst start = new Date(end.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst repository = String($env.MSIME_GITHUB_REPOSITORY ?? '');\nconst siteId = String($env.MSIME_PLAUSIBLE_SITE_ID ?? '');\nif (!repository || !siteId || !$env.MSIME_PLAUSIBLE_API_KEY || !$env.MSIME_GITHUB_TOKEN) {\n  throw new Error('缺少周报所需的 Plausible 或 GitHub 配置');\n}\nconst date = (value) => value.toISOString().slice(0, 10);\nreturn [{json: {\n  period_start: date(start),\n  period_end: date(end),\n  repository,\n  site_id: siteId,\n  install_goal: String($env.MSIME_PLAUSIBLE_INSTALL_GOAL ?? 'Install')\n}}];"
      },
